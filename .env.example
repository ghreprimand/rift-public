# Replace this placeholder before using a persistent/shared server.
# An empty token disables authentication; do not expose that mode remotely.
RIFT_TOKEN=replace-with-a-long-random-token
PORT=3300
HOST=127.0.0.1
# Resolve relative to the server process working directory; prefer an absolute path.
DATA_DIR=./data
# Optional comma-separated page origins when a reverse proxy rewrites Host.
# RIFT_ALLOWED_ORIGINS=https://rift.example.invalid
# Set explicitly in the process manager while activating a staged release.
# RIFT_MAINTENANCE=0
